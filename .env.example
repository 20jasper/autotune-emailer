# Nightscout site URL. No trailing slash.
NS_HOST=https://your-site.example.com

# Authentication: use one of these.
#
# Preferred: an access token (read-only is enough).
# Create one in Nightscout -> Admin tools -> Subjects -> Access token.
# NS_TOKEN=

# Or your Nightscout API secret. run.sh hashes it for you, so paste the
# plain secret here, not the SHA1 hash.
# NS_API_SECRET=

# Days BEFORE yesterday. The run includes yesterday, so 5 = a 6-day window.
# Use 6-13 for a 7-14 day window. The container aborts on any day with no
# CGM data, so don't reach back further than your Nightscout data goes.
AUTOTUNE_DAYS=6

# Keep this false unless you have a specific reason. See the README.
UAM_AS_BASAL=false

# Use the same timezone as your pump / Loop. Examples:
# America/New_York, Europe/London, Australia/Sydney, UTC
TZ=America/New_York

# Optional: use a named Nightscout profile instead of the default one.
# NS_PROFILE=Default

# Optional: insulin curve. rapid-acting = peak 75 min; ultra-rapid = peak 55 min.
# INSULIN_TYPE=rapid-acting

# Optional: safety caps and carb impact. Defaults are shown.
# AUTOSENS_MIN=0.7
# AUTOSENS_MAX=1.2
# MIN_5MIN_CARBIMPACT=8.0

# Optional: email the report after each run. Use an app-specific password,
# not your normal account password. Spaces in 16-character app passwords are
# ignored, so you can paste the code exactly as Google shows it.
#   Gmail:    smtp.gmail.com, port 587, STARTTLS, app password
#   Fastmail: smtp.fastmail.com, port 465, SSL, app password
#   iCloud:   smtp.mail.me.com, port 587, STARTTLS, app-specific password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@example.com
# SMTP_TO=you@example.com
